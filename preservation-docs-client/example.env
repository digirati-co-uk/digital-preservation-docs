# Copy to .env and fill in.

# Your platform instance
PRESERVATION_API_HOST=https://preservation-api.example
# Only if you have been given access to the Storage API (most clients have not)
STORAGE_API_HOST=

# OAuth2 client credentials for the API.
# The token endpoint and scope are those of the identity provider your platform instance uses.
# For Microsoft Entra ID (the provider current deployments use):
#   TOKEN_ENDPOINT=https://login.microsoftonline.com/<tenant-id>/oauth2/v2.0/token
#   SCOPE=api://<preservation-api-app-id>/.default
TOKEN_ENDPOINT=
CLIENT_ID=
CLIENT_SECRET=
SCOPE=

# true only for an API running locally with FeatureFlags:DisableAuth
DISABLE_AUTH=false

# Sent as X-Client-Identity; recorded by the API as who did what
CLIENT_IDENTITY=preservation-docs-samples

# AWS credentials with access to the deposit working bucket
AWS_PROFILE=default
AWS_REGION=eu-west-1

# A repository Container the samples may create Archival Groups under
DOCS_CONTAINER_PATH=docs-examples
